# Public origin of the app (Better Auth baseURL + request origin pinning).
# Required in production (server/index.js exits without it); dev defaults to http://localhost:5173.
ORIGIN="http://localhost:5173"

# App data directory (SQLite database, generated secrets). Default: ./data
#DATA_DIR="./data"

# libSQL connection string. Default: file:${DATA_DIR}/app.db
#DATABASE_URL="file:./data/app.db"

# Auth token signing secret. Optional: auto-generated and persisted under
# DATA_DIR/secrets/ when unset. BETTER_AUTH_SECRET_FILE may point to a file instead.
#BETTER_AUTH_SECRET=""

# Optional fixed first-run setup token. When unset, a one-time token is
# generated at startup and logged while zero users exist.
#SETUP_TOKEN=""

# Directory with drizzle-kit migrations applied at startup. Default: ./drizzle
#MIGRATIONS_DIR="./drizzle"
