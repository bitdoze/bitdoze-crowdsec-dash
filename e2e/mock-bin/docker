#!/bin/sh
# Stub docker for e2e — logs argv; `ps` emits a fixture JSONL when provided.
echo "docker $*" >> "${AGENT_CALLS_LOG:-/dev/null}"
case "$*" in
	"ps -a --no-trunc --format {{json .}}")
		cat "${DOCKER_PS_FIXTURE:-/dev/null}"
		;;
	"inspect --type container "*)
		echo '[{"Id":"stub","State":{"Status":"running"}}]'
		;;
	"exec "*)
		# docker exec <ctr> <proxy> <validate args> — fail when the flag file exists.
		if [ -f "${E2E_STUB_FLAG_DIR:-.e2e-data}/proxy-validate-fail" ]; then
			echo "mock: config validation failed" >&2
			exit 1
		fi
		echo "configuration is valid"
		;;
	"kill -s HUP "*)
		if [ -f "${E2E_STUB_FLAG_DIR:-.e2e-data}/proxy-reload-fail" ]; then
			echo "mock: reload failed" >&2
			exit 1
		fi
		;;
esac
exit 0
