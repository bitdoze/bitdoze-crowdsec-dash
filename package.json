{
	"name": "bitdoze-crowdsec-dash",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node server/index.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:e2e": "npm run build && playwright test",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"recover": "node scripts/recover.mjs",
		"backup": "node scripts/backup.mjs",
		"restore": "node scripts/restore.mjs",
		"drills": "node scripts/drills.mjs",
		"bench": "node scripts/bench.mjs"
	},
	"overrides": {
		"better-auth": {
			"@sveltejs/kit": "^3.0.0"
		}
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@libsql/client": "^0.18.0",
		"better-auth": "^1.7.18",
		"drizzle-orm": "^0.45.2",
		"nodemailer": "^10.3.1",
		"topojson-client": "^3.1.0",
		"undici": "^7.30.0",
		"world-atlas": "^2.0.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/public-sans": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.70.0",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.4",
		"@types/node": "^24",
		"@types/nodemailer": "^8.0.2",
		"@types/topojson-client": "^3.1.5",
		"auth": "^1.7.18",
		"bits-ui": "^2.20.6",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"layerchart": "^2.9.2",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	}
}
